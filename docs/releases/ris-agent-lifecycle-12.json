    "safe": {
      "variables": {"enable_agent_transport": true, "orders_agent_result_enabled": true},
      "exit": 0,
      "code": "NO_SHARED_DESTROY",
      "planChanges": 0,
      "planSha256Prefix": "c2a879bb"
    },
    "apply": false,
    "stateMutation": false
  },
  "lifecycleGates": {
    "catalog": "discovery and API only; never the worker or order reader",
