    "flags": ["enable_agent_transport", "orders_agent_result_enabled", "orders_lifecycle"]
  },
  "guard": {
    "module": "installer/shared_infra_guard.py",
    "codes": [
      "NO_SHARED_DESTROY",
      "MISSING_OR_FALSE_TRANSPORT_FLAG",
