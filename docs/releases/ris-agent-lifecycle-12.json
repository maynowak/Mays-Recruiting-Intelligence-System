    "intentBinding": "planSha256",
    "wiredInto": ["plan", "apply", "install", "destroy"],
    "toctouCheck": true,
    "commandRedaction": true
  },
  "livePlanProof": {
    "hazard": {
      "variables": {"orders_agent_result_enabled": true},
      "exit": 1,
      "code": "MISSING_OR_FALSE_TRANSPORT_FLAG",
