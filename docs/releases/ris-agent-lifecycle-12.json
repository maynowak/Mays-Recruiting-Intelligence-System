      "SHARED_TEARDOWN_AUTHORIZED",
      "TEARDOWN_INTENT_INVALID",
      "PLAN_SHAPE_INVALID",
      "GUARD_UNREADABLE"
    ],
    "failClosedOn": [
      "missing or unreadable plan",
      "missing resource_changes",
      "non-string actions",
      "change: null",
      "errored or incomplete plan",
      "shared delete/replace/forget without intent",
      "malformed teardown intent"
    ],
    "protectedModules": [
      "agent_transport", "mays_orders", "lambda", "dynamodb", "cognito",
      "orders_reader", "api", "sqs", "iam", "health_plane", "health_public",
      "health", "monitoring", "monitoring_orders", "documents", "cloudtrail",
      "jobsearch_edge", "partner_edge"
