# Local .terraform directories
.terraform/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Ignore Terraform plan files saved with -out=tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout
### RIS Installer Local Workspace
# Project checkouts (including Mays-Orders-AWS from git clone)
projects/

# Mays-Orders-AWS Git-Clone (fremdes Projekt, rein lokal, nie committen).
# Wird nur als Lese-Referenz + Versions-Pin (installer/mays-orders-clone.pinned.json)
# behandelt; Aenderungen am Live-System erfolgen ausschliesslich als
# Post-Install-Update der Lambda-Funktion, nie im Clone-Workflow.
installer/projects/

# Local installer runtime
.mays-installer/
.ris-installer/

# Lambda build artifacts (built at install time, never committed)
lambda/dist/
lambda.zip

# Generated Mays-Orders Terraform module (built by installer/build_mays_orders_module.py).
# Only the wrapper, its README and the execution report are versioned.
terraform/modules/mays_orders/

# Agent/session scratch in the repo root (kanonische Ablage: docs/reports/ + docs/AI_AUDITLOG.md).
# Katalog siehe docs/reports/2026-10-20-ROOT-SCRATCH-KATALOG.md
/AI_AUDITLOG_*.md
/CLEANUP_*.md
/STATE_*.md
/STATE_CHECKS_*.sh
/DISCOVERY_*.md
*_SUMMARY.md
*_SUMMARY.txt
installer/ris.py.backup
installer/ris.py.work_in_progress
/tmp/

